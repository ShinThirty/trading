{
  "mcpServers": {
    "trading-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--package",
        "trading-mcp",
        "trading-mcp"
      ],
      "env": {
        "PIPELINE_STATE_BUCKET": "trading-alerts-state",
        "PIPELINE_STATE_KEY": "pipeline.json"
      }
    }
  }
}